# Copy to .env.local for local development, and set the same value in your host's
# environment variables (e.g. Vercel → Project → Settings → Environment Variables).
#
# This is the ONLY environment variable, and it is public (embedded in the HTML).

# The public URL of the deployed site, without a trailing slash.
# Needed so WhatsApp / Facebook link previews can load the preview image (og:image), and for the canonical URL.
# On Vercel it can be left unset: the production domain (VERCEL_PROJECT_PRODUCTION_URL) is used as a fallback.
# Without either, URLs fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
